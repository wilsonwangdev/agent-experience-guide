---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="404 — Not Found" lang="en">
  <main class="landing" style="text-align: center; padding-top: 6rem;">
    <h1>Page Not Found</h1>
    <p style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2rem;">
      The page you're looking for doesn't exist.
    </p>
    <nav style="display: flex; gap: 1.5rem; justify-content: center; font-size: 1rem;">
      <a href="/">Home</a>
      <a href="/docs/00-what-is-ax">Guide</a>
      <a href="/docs/08-checklist">Checklist</a>
    </nav>
  </main>
</BaseLayout>
