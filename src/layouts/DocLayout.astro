---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import AgentSummary from '../components/AgentSummary.astro';
import ModeToggle from '../components/ModeToggle.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'zh';
  currentSlug: string;
  frontmatter?: CollectionEntry<'docs'>['data'];
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, lang, currentSlug, frontmatter, headings = [] } = Astro.props;
const navGuide = lang === 'zh' ? '指南' : 'Guide';
const navChecklist = lang === 'zh' ? '检查清单' : 'Checklist';
const navRefs = lang === 'zh' ? '参考资料' : 'References';
const prefix = lang === 'zh' ? '/zh' : '';
---

<BaseLayout title={title} description={description} lang={lang} ogType="article">
  <header class="top-nav">
    <div class="nav-left">
      <a href={prefix || '/'} class="logo">AX Guide</a>
      <nav class="main-nav">
        <a href={`${prefix}/docs/00-what-is-ax`}>{navGuide}</a>
        <a href={`${prefix}/docs/08-checklist`}>{navChecklist}</a>
        <a href={`${prefix}/docs/references`}>{navRefs}</a>
      </nav>
    </div>
    <div class="nav-right">
      <LangSwitcher />
      <ThemeToggle />
      <ModeToggle />
      <a href="https://github.com/wilsonwangdev/agent-experience-guide" target="_blank" rel="noopener" class="nav-icon" aria-label="GitHub" title="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>
  </header>

  <div class="doc-layout">
    <div class="human-only">
      <Sidebar currentSlug={currentSlug} lang={lang} />
    </div>
    <main class="doc-main" id="main-content">
      {frontmatter && (
        <AgentSummary frontmatter={frontmatter} headings={headings} />
      )}
      <article class="prose">
        <slot />
      </article>
    </main>
  </div>

  <footer class="site-footer">
    <div class="footer-content">
      <span>Agent Experience Guide — MIT License</span>
      <nav>
        <a href="/llms.txt">llms.txt</a>
        <a href="/AGENTS.md">AGENTS.md</a>
        <a href="/auth.md">auth.md</a>
        <a href="/capabilities.json">capabilities.json</a>
        <a href="https://github.com/wilsonwangdev/agent-experience-guide/issues" target="_blank" rel="noopener">Issues</a>
      </nav>
    </div>
  </footer>
</BaseLayout>